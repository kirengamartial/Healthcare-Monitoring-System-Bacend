{
  "name": "patient-management-api",
  "version": "1.0.0",
  "description": "Patient Management System API",
  "main": "src/server.js",
  "scripts": {
    "start": "node api/index.js",
    "dev": "nodemon api/index.js",
    "build": "npm install",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest \".*\\.unit\\.test\\.js$\"",
    "test:integration": "jest \".*\\.integration\\.test\\.js$\"",
    "test:e2e": "jest \".*\\.e2e\\.test\\.js$\"",
    "test:performance": "artillery run ./tests/performance/load-test.yml",
    "test:perf:100": "artillery run --target \"http://localhost:3000/api\" --phase \"100 users\" ./tests/performance/load-test.yml",
    "test:perf:200": "artillery run --target \"http://localhost:3000/api\" --phase \"200 users\" ./tests/performance/load-test.yml",
    "test:perf:500": "artillery run --target \"http://localhost:3000/api\" --phase \"500 users\" ./tests/performance/load-test.yml",
    "test:perf:1000": "artillery run --target \"http://localhost:3000/api\" --phase \"1000 users\" ./tests/performance/load-test.yml",
    "test:perf:2000": "artillery run --target \"http://localhost:3000/api\" --phase \"2000 users\" ./tests/performance/load-test.yml",
    "test:perf:5000": "artillery run --target \"http://localhost:3000/api\" --phase \"5000 users\" ./tests/performance/load-test.yml",
    "test:perf:10000": "artillery run --target \"http://localhost:3000/api\" --phase \"10000 users\" ./tests/performance/load-test.yml",
    "test:perf:all": "artillery run ./tests/performance/load-test.yml"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "artillery": "^2.0.23",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "supertest": "^7.1.1"
  }
}
